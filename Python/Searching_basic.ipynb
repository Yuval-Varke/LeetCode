    "1. Linear Search"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "79dcbbd2",
   "metadata": {},
   "outputs": [],
   "source": [
    "def linear_search(arr,target):\n",
    "    for index,x in enumerate(arr):\n",
    "        if x == target:\n",
    "            return index\n",
    "    return -1"
   ]
  },
