   "source": [
    "1. Find the largest in a list"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "a31a1146",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Largest element is 95\n"
     ]
    }
   ],
   "source": [
    "numbers = [12, 45, 7, 89, 34, 95, 62, 57]\n",
    "\n",
    "\n",
    "largest = numbers[0]\n",
    "for i in numbers[1:]:\n",
    "    if i > largest:\n",
    "        largest = i\n",
    "print(f'Largest element is {largest}')\n"
   ]
  }
